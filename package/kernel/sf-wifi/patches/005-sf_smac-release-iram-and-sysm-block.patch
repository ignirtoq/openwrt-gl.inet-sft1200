sf_smac: release shared IRAM and band sysm block before use

On the GL-SFT1200 nothing releases the shared WiFi IRAM (sysm offset
0x0c00) or the band's own sysm block (0x8000 LB, 0xc400 HB) from reset and
clock gating before the driver starts using them. Probing the 5 GHz band
then locks up the bus. Mirror the vendor kernel's release_reset() sequence
(clock enable, reset release, bus output enable) before the band is first
touched. IRAM is shared by both bands and is left powered, so the LB-only
"iram_reset" control becomes optional.

--- a/sf_smac/src/bb_src/umac/siwifi_mpw0.c
+++ b/sf_smac/src/bb_src/umac/siwifi_mpw0.c
@@ -6,6 +6,7 @@
 #include <linux/of_net.h>
 #include <linux/mtd/mtd.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/reset.h>
@@ -611,6 +612,50 @@
     return -1;
 }
 #endif
+/*
+ * The shared WiFi IRAM and each band's sysm block start out held in reset
+ * and clock-gated, and nothing else on this platform releases them. Do it
+ * here the way the vendor kernel's release_reset() does, before the driver
+ * first touches the band (reset release, share-RAM select, firmware load).
+ * IRAM is shared by both bands and is left powered.
+ */
+#define SF_SYSM_PHYS		0x19e00000
+#define SF_SYSM_IRAM		0x0c00
+#define SF_SYSM_WIFI_LB		0x8000
+#define SF_SYSM_WIFI_HB		0xc400
+#define SF_SYSM_CLK_EN		0x04
+#define SF_SYSM_BOE		0x0c
+#define SF_SYSM_MEMCTL		0x14
+#define SF_SYSM_IRAM_RST1	0x1c
+#define SF_SYSM_IRAM_CLK1_EN	0x20
+
+static void sf_wifi_sysm_power_on(struct mpw0_plat_data *priv)
+{
+    void __iomem *sysm;
+    u32 blk = (priv->band & LB_MODULE) ? SF_SYSM_WIFI_LB : SF_SYSM_WIFI_HB;
+
+    sysm = ioremap(SF_SYSM_PHYS, 0x10000);
+    if (!sysm) {
+        printk("%s: failed to map sysm\n", __func__);
+        return;
+    }
+    if (readl(sysm + SF_SYSM_IRAM) || readl(sysm + SF_SYSM_IRAM + SF_SYSM_IRAM_RST1)) {
+        writel(0xff, sysm + SF_SYSM_IRAM + SF_SYSM_CLK_EN);
+        writel(0xff, sysm + SF_SYSM_IRAM + SF_SYSM_IRAM_CLK1_EN);
+        udelay(1);
+        writel(0, sysm + SF_SYSM_IRAM);
+        writel(0, sysm + SF_SYSM_IRAM + SF_SYSM_IRAM_RST1);
+        udelay(1);
+        writel(0xf, sysm + SF_SYSM_IRAM + SF_SYSM_BOE);
+    }
+    writel(0, sysm + blk + SF_SYSM_MEMCTL);
+    writel(0xff, sysm + blk + SF_SYSM_CLK_EN);
+    udelay(1);
+    writel(0, sysm + blk);
+    udelay(1);
+    writel(0xf, sysm + blk + SF_SYSM_BOE);
+    iounmap(sysm);
+}
